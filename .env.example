# EmailJS (contact form) — publishable client-side identifiers, safe in the bundle.
# Copy to `.env` for local dev, or set as GitHub Actions secrets for deploys.
VITE_EMAILJS_SERVICE_ID=service_7fek9fa
VITE_EMAILJS_TEMPLATE_ID=template_5abkbuq
VITE_EMAILJS_PUBLIC_KEY=sx3AVsFjV2yxPLAen

# Base path for the built site.
#   "/"            → custom domain or a <user>.github.io repo (default)
#   "/anujsingh/"  → GitHub *project* pages (repo served under its name)
VITE_BASE=/
